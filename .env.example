# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- The model under test -------------------------------------------------
# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# --- The judge model used by DeepEval -------------------------------------
# DeepEval metrics (AnswerRelevancy, Faithfulness, Hallucination, GEval) call
# an LLM to score the answers, and it speaks the OpenAI protocol. Pointing
# OPENAI_BASE_URL at Groq's OpenAI-compatible endpoint makes the judge run on
# Groq too, so no OpenAI account is needed. Reuse the same Groq key.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=your_groq_key_here
